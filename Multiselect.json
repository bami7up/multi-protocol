{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8"
    ],
    "queryStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "tag": "REALITY_VISION",
      "port": 10443,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "rawSettings": {
          "acceptProxyProtocol": false
        },
        "realitySettings": {
          "show": false,
          "xver": 0,
          "minClientVer": "0.0.0",
          "target": "127.0.0.1:9443",
          "shortIds": [
            ""
          ],
          "privateKey": "",
          "serverNames": [
            "<prefix>1.<domain>"
          ]
        }
      }
    },
    {
      "tag": "REALITY_XHTTP",
      "port": 10444,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "xhttpSettings": {
          "mode": "auto",
          "path": "/api/v3/sync/r1"
        },
        "realitySettings": {
          "show": false,
          "xver": 0,
          "minClientVer": "0.0.0",
          "target": "www.gstatic.com:443",
          "shortIds": [
            ""
          ],
          "privateKey": "",
          "serverNames": [
            "www.gstatic.com"
          ]
        }
      }
    },
    {
      "tag": "HYSTERIA2",
      "port": 443,
      "listen": "0.0.0.0",
      "protocol": "hysteria",
      "settings": {
        "clients": [],
        "version": 2
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "finalmask": {
          "quicParams": {
            "debug": false,
            "congestion": "bbr"
          }
        },
        "tlsSettings": {
          "alpn": [
            "h3"
          ],
          "serverName": "<prefix>3.<domain>",
          "certificates": [
            {
              "keyFile": "/etc/remna-certs/<prefix>3.<domain>/key.pem",
              "certificateFile": "/etc/remna-certs/<prefix>3.<domain>/fullchain.pem"
            }
          ]
        },
        "hysteriaSettings": {
          "version": 2
        }
      }
    },
    {
      "tag": "VLESS_CDN_WS",
      "port": 10446,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/api/v1/stream"
        }
      }
    },
    {
      "tag": "VLESS_CDN_XHTTP",
      "port": 10447,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "mode": "auto",
          "path": "/api/v3/sync/c1"
        }
      }
    },
    {
      "tag": "VLESS_CDN_GRPC",
      "port": 10448,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {
          "serviceName": "/api/v4/stream"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4"
      }
    },
    {
      "tag": "BLOCK",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "rules": [
      {
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "BLOCK"
      },
      {
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "BLOCK"
      }
    ],
    "domainStrategy": "IPIfNonMatch"
  }
}